<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TrailToTrophy</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% if (typeof user !== 'undefined' && user) { %>
    <nav class="navbar">
      <div class="nav-container">
        <a href="/dashboard" class="nav-brand">🏅 TrailToTrophy</a>
        <div class="nav-menu">
          <div class="nav-user">
            <img src="<%= user.avatar %>" alt="<%= user.name %>" class="user-avatar">
            <span><%= user.name %></span>
            <a href="/logout" class="btn-logout">Logout</a>
          </div>
        </div>
      </div>
    </nav>
  <% } %>
  <div class="container">
    <div class="hero">
      <h1>🏅 TrailToTrophy</h1>
      <p class="subtitle">Track your fitness activities and challenges</p>
    </div>

    <div class="login-section">
      <h2>Get Started</h2>
      <p>Sign in with your Google account to start tracking your fitness journey</p>
      <a href="/auth/google" class="btn btn-google" role="button">
        <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          <path fill="none" d="M0 0h48v48H0z"/>
        </svg>
        <span>Sign in with Google</span>
      </a>
    </div>

    <div class="features">
      <div class="feature">
        <h3>🔗 Secure Login</h3>
        <p>Sign in securely with your Google account</p>
      </div>
      <div class="feature">
        <h3>📊 Track Activities</h3>
        <p>View all your workouts in one place</p>
      </div>
      <div class="feature">
        <h3>🔍 Filter & Sort</h3>
        <p>Filter by activity type and fitness app</p>
      </div>
    </div>
  </div>
</body>
</html>
